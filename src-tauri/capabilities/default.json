{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.hypergryph.com/**" },
        { "url": "https://*.hycdn.cn/**" },
        { "url": "https://*.skland.com/**" },
        { "url": "https://api.qrserver.com/**" }
      ]
    },
    "android-intent:allow-openLink",
    "android-intent:allow-saveMedia",
    "android-intent:allow-saveMediaFromUrl",
    "android-intent:allow-saveMediaFromFile",
    "android-intent:allow-checkPermissions",
    "android-intent:allow-requestPermissions",
    "android-intent:allow-openAppSettings",
    "fs:allow-download-write-recursive",
    "fs:allow-download-read-recursive",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": ["http", "https"]
        }
      ]
    }
  ]
}
